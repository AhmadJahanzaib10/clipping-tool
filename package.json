{
  "name": "clip-engine",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx scripts/run-web.ts dev",
    "build": "pnpm --filter @clip/web build",
    "start": "tsx scripts/run-web.ts start",
    "worker": "pnpm --filter @clip/worker start",
    "test": "vitest run && pnpm run test:py",
    "lint": "pnpm -r typecheck && tsc -p tsconfig.scripts.json",
    "doctor": "tsx scripts/doctor.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "sfx:scan": "tsx scripts/sfx-scan.ts",
    "test:py": "python -m pytest -q py",
    "check:clips": "tsx scripts/check-clips.ts",
    "requeue": "tsx scripts/requeue.ts",
    "check:plans": "tsx scripts/check-plans.ts",
    "release:stale": "tsx scripts/release-stale.ts",
    "check:render": "tsx scripts/check-render.ts"
  },
  "devDependencies": {
    "@clip/shared": "workspace:*",
    "@types/node": "^22.20.5",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7",
    "zod": "^4.6.7"
  }
}
